{
  "expo": {
    "name": "Batalha Gladiador",
    "slug": "batalha_gladiador_mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/imagens/icon.png",
    "scheme": "batalhagladiadormobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/imagens/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/imagens/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#cdedb3",
          "image": "./assets/imagens/splash-icon.png",
          "imageWidth": 160
        }
      ]
    ]
  }
}
